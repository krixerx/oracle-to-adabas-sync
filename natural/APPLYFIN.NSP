* APPLYFIN - sync apply API for TRAFFINE (Adabas file 20).
*
* Reads one mapped batch (the mainframe-facing change files produced by
* the Hop reverse-mapping pipelines) and applies it to Adabas THROUGH
* Natural - i.e. through whatever business logic lives here. That is
* this design's genuine advantage over a tool that writes into Adabas
* directly and so bypasses Natural validation (spec decision D5).
*
* FILE FORMAT: FIXED-WIDTH (resolves open decision O3). READ WORK FILE
* into a record structure does positional parsing natively, so there is
* no delimiter, quoting or empty-field handling to get wrong. The
* capture side keeps CSV; only the mainframe-facing leg is fixed-width.
* Layouts are in CHANGE_FILE_CONTRACT.md.
*
* Input work files (staged into /sync/work by run-apply.sh):
*   WF1 traffic_fine.dat            parent records
*   WF2 traffic_fine_offence.dat        MU - offences from one stop
*   WF3 traffic_fine_payment.dat        PE - part payments
*   WF6 batch_info.dat              batch number + end SCN
* Output:
*   WF5 apply_result.txt            one line per record + SUMMARY
*
* Key behaviours (spec C6):
*   - op=D deletes (project owner's decision 2026-08-10, POC scope)
*   - op=U is a FULL-STATE upsert, never a diff
*   - COMPARE BEFORE WRITE: identical record => skip, count a no-op.
*     Terminates echo loops and makes replay safe (decisions D7 / 5.2).
*   - MU/PE sets replaced IN FULL; shrinking REQUIRES resetting the
*     trailing occurrences BEFORE lowering the count - see SPIKEMU.NSP.
*   - ledger (file 99) written in the SAME ET as the data, so restart is
*     atomic: there is no window where data is applied but the mark is not.
*
* NUMERIC TEXT: amounts and dates arrive as ALPHANUMERIC with an explicit
* decimal point ("00085.00", "20230505") and are converted here with VAL.
* Deliberate: a numeric field rendered by Hop would go through the
* server locale, and a comma decimal separator would arrive as a
* different amount with nothing to notice it.
*
* Headless: NO terminal WRITE statements (would trip the MORE prompt).
DEFINE DATA LOCAL
1 V VIEW OF TRAFFINE
  2 FINE-NO
  2 PLATE-NO
  2 OFFENCE-DATE
  2 LOCATION
  2 AMOUNT
  2 STATUS
  2 OFFENDER-ID
  2 C*OFFENCE-CODE
  2 OFFENCE-CODE (1:20)
  2 C*PAYMENT
  2 PAY-DATE (1:20)
  2 PAY-AMT (1:20)
  2 PAY-METH (1:20)
1 L VIEW OF LEDGER
  2 STREAM-ID
  2 LAST-BATCH
  2 LAST-SCN
  2 APPLIED-UTC
  2 ROWS-APPLIED
  2 ROWS-SKIPPED
  2 ROWS-REJECTED
*
* ---- parent record layout (81 bytes) -------------------------------
1 #REC
  2 #OP        (A1)
  2 #FINE-NO   (A10)
  2 #PLATE-NO  (A15)
  2 #ODATE8    (A8)
  2 #LOCATION  (A30)
  2 #AMOUNT8   (A8)
  2 #STATUS    (A1)
  2 #OFFENDER  (A8)
* ---- child record layouts ------------------------------------------
1 #OFF-REC
  2 #OFF-KEY  (A10)
  2 #OFF-IDX  (N3)
  2 #OFF-VAL  (A4)
1 #PAY-REC
  2 #PAY-KEY   (A10)
  2 #PAY-IDX   (N3)
  2 #PAY-DATE8 (A8)
  2 #PAY-AMT8  (A8)
  2 #PAY-METH  (A2)
1 #BATCH-REC
  2 #BATCH-NO (N6)
  2 #END-SCN  (N15)
*
1 #OFF      (A4/1:20)
1 #OFF-CNT  (I4)
1 #PDATE    (N8/1:20)
1 #PAMT     (P7.2/1:20)
1 #PMETH    (A2/1:20)
1 #PAY-CNT  (I4)
*
1 #LINE        (A) DYNAMIC
1 #I           (I4)
1 #FOUND       (L)
1 #SAME        (L)
1 #CNT-APPLIED (I4)
1 #CNT-SKIPPED (I4)
1 #CNT-DELETED (I4)
1 #CNT-STORED  (I4)
1 #LEDGER-FOUND (L)
1 #SKIP        (L)
1 #FROM        (I4)
END-DEFINE
*
DEFINE WORK FILE 6 '/sync/work/batch_info.dat' TYPE 'ASCII'
DEFINE WORK FILE 5 '/sync/work/apply_result.txt' TYPE 'ASCII'
DEFINE WORK FILE 1 '/sync/work/traffic_fine.dat' TYPE 'ASCII'
DEFINE WORK FILE 2 '/sync/work/traffic_fine_offence.dat' TYPE 'ASCII'
DEFINE WORK FILE 3 '/sync/work/traffic_fine_payment.dat' TYPE 'ASCII'
*
RESET #SKIP
* READ ... ONCE opens no processing loop, so it takes no END-WORK
READ WORK FILE 6 ONCE #BATCH-REC
*
* ---- guard: never apply a batch at or below the watermark ----------
* Batches must be applied in order and exactly once. The ledger is the
* single source of truth for "how far did we get" (spec 5.3).
RESET #LEDGER-FOUND
FIND L WITH STREAM-ID = 'APPLY'
  #LEDGER-FOUND := TRUE
  IF LAST-BATCH GE #BATCH-NO
    #SKIP := TRUE
  END-IF
END-FIND
*
IF #SKIP
  COMPRESS 'ALREADY-APPLIED batch' #BATCH-NO
    'is not newer than the ledger' INTO #LINE
  WRITE WORK FILE 5 VARIABLE #LINE
  WRITE WORK FILE 5 VARIABLE 'SUMMARY skipped-whole-batch'
  CLOSE WORK FILE 5
  ESCAPE ROUTINE
END-IF
*
PERFORM LOAD-CHILDREN
*
RD1. READ WORK FILE 1 #REC
  IF #OP = 'D'
    PERFORM APPLY-DELETE
  ELSE
    PERFORM APPLY-UPSERT
  END-IF
END-WORK
*
* ---- ledger + data committed together ------------------------------
IF #LEDGER-FOUND
  FIND L WITH STREAM-ID = 'APPLY'
    LAST-BATCH    := #BATCH-NO
    LAST-SCN      := #END-SCN
    APPLIED-UTC   := *TIMX
    ROWS-APPLIED  := #CNT-APPLIED
    ROWS-SKIPPED  := #CNT-SKIPPED
    UPDATE
  END-FIND
ELSE
  RESET L
  STREAM-ID     := 'APPLY'
  LAST-BATCH    := #BATCH-NO
  LAST-SCN      := #END-SCN
  APPLIED-UTC   := *TIMX
  ROWS-APPLIED  := #CNT-APPLIED
  ROWS-SKIPPED  := #CNT-SKIPPED
  ROWS-REJECTED := 0
  STORE L
END-IF
END TRANSACTION
*
COMPRESS 'SUMMARY batch=' #BATCH-NO 'stored=' #CNT-STORED
  'updated=' #CNT-APPLIED 'skipped=' #CNT-SKIPPED
  'deleted=' #CNT-DELETED INTO #LINE
WRITE WORK FILE 5 VARIABLE #LINE
CLOSE WORK FILE 5
*
* ====================================================================
DEFINE SUBROUTINE APPLY-DELETE
  RESET #FOUND
  FIND V WITH FINE-NO = #FINE-NO
    #FOUND := TRUE
    DELETE
  END-FIND
  IF #FOUND
    ADD 1 TO #CNT-DELETED
    COMPRESS 'DELETED' #FINE-NO INTO #LINE
  ELSE
*   Already absent = already applied. Idempotent by design, not an error.
    ADD 1 TO #CNT-SKIPPED
    COMPRESS 'NOOP-DELETE-ABSENT' #FINE-NO INTO #LINE
  END-IF
  WRITE WORK FILE 5 VARIABLE #LINE
END-SUBROUTINE
*
* ====================================================================
DEFINE SUBROUTINE APPLY-UPSERT
  RESET #FOUND #SAME
  FIND V WITH FINE-NO = #FINE-NO
    #FOUND := TRUE
    PERFORM COMPARE-RECORD
    IF #SAME
*     COMPARE-BEFORE-WRITE (D7). The record is already in the desired
*     state, so writing would only generate a PLOG entry that the other
*     leg would capture and send back. Skipping terminates the loop.
*     In steady state this counter should sit near zero - a rising
*     count means the originator filter is leaking.
      ADD 1 TO #CNT-SKIPPED
      COMPRESS 'NOOP-IDENTICAL' #FINE-NO INTO #LINE
      WRITE WORK FILE 5 VARIABLE #LINE
    ELSE
      PERFORM MOVE-FIELDS
      UPDATE
      ADD 1 TO #CNT-APPLIED
      COMPRESS 'UPDATED' #FINE-NO INTO #LINE
      WRITE WORK FILE 5 VARIABLE #LINE
    END-IF
  END-FIND
*
  IF NOT #FOUND
    RESET V
    PERFORM MOVE-FIELDS
    STORE V
    ADD 1 TO #CNT-STORED
    COMPRESS 'STORED' #FINE-NO INTO #LINE
    WRITE WORK FILE 5 VARIABLE #LINE
  END-IF
END-SUBROUTINE
*
* ====================================================================
* Is the Adabas record already exactly what the batch asks for?
* Compared AFTER mapping - Adabas values against Adabas values in one
* type system - which is why this works where content hashing across
* the conversion boundary did not.
DEFINE SUBROUTINE COMPARE-RECORD
  #SAME := TRUE
  IF PLATE-NO NE #PLATE-NO OR LOCATION NE #LOCATION
    #SAME := FALSE
  END-IF
  IF OFFENCE-DATE NE VAL(#ODATE8) OR AMOUNT NE VAL(#AMOUNT8)
    #SAME := FALSE
  END-IF
  IF STATUS NE #STATUS OR OFFENDER-ID NE #OFFENDER
    #SAME := FALSE
  END-IF
  IF C*OFFENCE-CODE NE #OFF-CNT OR C*PAYMENT NE #PAY-CNT
    #SAME := FALSE
  END-IF
  IF #SAME
    FOR #I = 1 TO #OFF-CNT
      IF OFFENCE-CODE(#I) NE #OFF(#I)
        #SAME := FALSE
      END-IF
    END-FOR
  END-IF
  IF #SAME
    FOR #I = 1 TO #PAY-CNT
      IF PAY-DATE(#I) NE #PDATE(#I) OR PAY-AMT(#I) NE #PAMT(#I)
        #SAME := FALSE
      END-IF
      IF PAY-METH(#I) NE #PMETH(#I)
        #SAME := FALSE
      END-IF
    END-FOR
  END-IF
END-SUBROUTINE
*
* ====================================================================
DEFINE SUBROUTINE MOVE-FIELDS
  FINE-NO      := #FINE-NO
  PLATE-NO     := #PLATE-NO
  OFFENCE-DATE := VAL(#ODATE8)
  LOCATION     := #LOCATION
  AMOUNT       := VAL(#AMOUNT8)
  STATUS       := #STATUS
  OFFENDER-ID  := #OFFENDER
*
* ---- MU/PE FULL-SET REPLACEMENT (D8) -------------------------------
* RESET the trailing occurrences BEFORE lowering the count. Lowering
* the count alone leaves the old values in place AND leaves the count
* unchanged - silent corruption. Proven by SPIKEMU.NSP 2026-08-10.
  FOR #I = 1 TO #OFF-CNT
    OFFENCE-CODE(#I) := #OFF(#I)
  END-FOR
  IF #OFF-CNT LT 20
    RESET OFFENCE-CODE(#OFF-CNT + 1:20)
  END-IF
  C*OFFENCE-CODE := #OFF-CNT
*
  FOR #I = 1 TO #PAY-CNT
    PAY-DATE(#I) := #PDATE(#I)
    PAY-AMT(#I)  := #PAMT(#I)
    PAY-METH(#I) := #PMETH(#I)
  END-FOR
* A PE occurrence survives while ANY field in the group still holds a
* value, so EVERY field of a removed occurrence has to be cleared, not
* just the one being inspected. Here all three PE fields are mapped, so
* the employee aggregate's nastier case (an unmapped BONUS keeping the
* occurrence alive) cannot arise - but the rule is the same, and adding
* a fourth field to the group without resetting it would reintroduce it.
* NAT0027: a FOR start value must be a variable, not an expression
  #FROM := #PAY-CNT + 1
  FOR #I = #FROM TO 20
    RESET PAY-DATE(#I)
    RESET PAY-AMT(#I)
    RESET PAY-METH(#I)
  END-FOR
  C*PAYMENT := #PAY-CNT
END-SUBROUTINE
*
* ====================================================================
* Batches in this POC carry one aggregate at a time, so the child sets
* are loaded once into arrays rather than re-read per parent.
DEFINE SUBROUTINE LOAD-CHILDREN
  RESET #OFF-CNT #PAY-CNT
  RD2. READ WORK FILE 2 #OFF-REC
    ADD 1 TO #OFF-CNT
    #OFF(#OFF-CNT) := #OFF-VAL
  END-WORK
  RD3. READ WORK FILE 3 #PAY-REC
    ADD 1 TO #PAY-CNT
    #PDATE(#PAY-CNT) := VAL(#PAY-DATE8)
    #PAMT(#PAY-CNT)  := VAL(#PAY-AMT8)
    #PMETH(#PAY-CNT) := #PAY-METH
  END-WORK
END-SUBROUTINE
*
END
