* DUMPEMP - dumps one EMPLOYEES record as text so the test harness can
* assert on Adabas state from outside (sync-verify.cmd).
* Reads the personnel id from /sync/work/dump_key.txt.
* No terminal WRITE (headless); output goes to work file 5.
DEFINE DATA LOCAL
1 V VIEW OF EMPLOYEES
  2 PERSONNEL-ID
  2 FIRST-NAME
  2 MIDDLE-NAME
  2 NAME
  2 MAR-STAT
  2 SEX
  2 BIRTH
  2 CITY
  2 POST-CODE
  2 COUNTRY
  2 DEPT
  2 JOB-TITLE
  2 C*ADDRESS-LINE
  2 ADDRESS-LINE (1:20)
  2 C*LANG
  2 LANG (1:20)
  2 C*INCOME
  2 CURR-CODE (1:20)
  2 SALARY (1:20)
1 #KEY  (A8)
1 #LINE (A) DYNAMIC
1 #B8   (A8)
1 #I    (I4)
1 #N    (I4)
END-DEFINE
*
DEFINE WORK FILE 6 '/sync/work/dump_key.txt' TYPE 'ASCII'
DEFINE WORK FILE 5 '/sync/work/dump_result.txt' TYPE 'ASCII'
*
READ WORK FILE 6 ONCE #KEY
*
RESET #N
FIND V WITH PERSONNEL-ID = #KEY
  ADD 1 TO #N
  MOVE EDITED BIRTH (EM=YYYYMMDD) TO #B8
  COMPRESS 'FOUND' PERSONNEL-ID INTO #LINE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'FIRSTNAME=' FIRST-NAME INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'NAME=' NAME INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'CITY=' CITY INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'JOB=' JOB-TITLE INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'BIRTH=' #B8 INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'MARSTAT=' MAR-STAT INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'CADR=' C*ADDRESS-LINE INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'CLANG=' C*LANG INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
  COMPRESS 'CINC=' C*INCOME INTO #LINE LEAVING NO SPACE
  WRITE WORK FILE 5 VARIABLE #LINE
* Dump 6 occurrences regardless of the count, so a test can prove that
* residue beyond the count is really gone rather than merely uncounted.
  FOR #I = 1 TO 6
    COMPRESS 'ADR' #I '=' ADDRESS-LINE(#I) INTO #LINE LEAVING NO SPACE
    WRITE WORK FILE 5 VARIABLE #LINE
  END-FOR
  FOR #I = 1 TO 6
    COMPRESS 'LANG' #I '=' LANG(#I) INTO #LINE LEAVING NO SPACE
    WRITE WORK FILE 5 VARIABLE #LINE
  END-FOR
  FOR #I = 1 TO 6
    COMPRESS 'INC' #I '=' CURR-CODE(#I) '/' SALARY(#I) INTO #LINE
      LEAVING NO SPACE
    WRITE WORK FILE 5 VARIABLE #LINE
  END-FOR
END-FIND
*
IF #N = 0
  COMPRESS 'NOTFOUND' #KEY INTO #LINE
  WRITE WORK FILE 5 VARIABLE #LINE
END-IF
CLOSE WORK FILE 5
*
END
