<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>72_sync_employee_income</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>this lab reverse mapping: outbox employee_income.csv -&gt; fixed-width inbox employee_income.dat (PE child set).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter><name>BATCH_IN</name><default_value>/sync/outbox/batch-000001</default_value><description>Source batch directory (CSV)</description></parameter>
      <parameter><name>BATCH_OUT</name><default_value>/sync/inbox/batch-000001</default_value><description>Target batch directory (fixed-width)</description></parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/10 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/10 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>read employee_income.csv</name>
    <filename>${BATCH_IN}/employee_income.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>parent_key</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>occurrence_index</name><length>-1</length><type>Integer</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>currency_code</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>salary_amount</name><length>-1</length><type>Integer</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>112</yloc></GUI>
    <description/>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>write employee_income.dat</name>
    <schema_definition/>
    <separator/>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>N</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${BATCH_OUT}/employee_income</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>dat</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>Y</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>parent_key</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>occurrence_index</name><type>Integer</type><format>000</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>3</length><precision>0</precision></field>
      <field><name>currency_code</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>3</length><precision>-1</precision></field>
      <field><name>salary_amount</name><type>Integer</type><format>000000000</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>9</length><precision>0</precision></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>384</xloc><yloc>112</yloc></GUI>
    <description>Fixed-width. occurrence_index is LEFT-ZERO-padded via the 000 format mask (Natural reads it as N3); alphanumerics are right-space-padded by pad=Y.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>read employee_income.csv</from><to>write employee_income.dat</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
