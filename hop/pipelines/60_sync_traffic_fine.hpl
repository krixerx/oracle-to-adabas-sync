<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>60_sync_traffic_fine</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reverse mapping: outbox traffic_fine.csv -&gt; fixed-width inbox traffic_fine.dat. Turns the FINE_STATUS description back into the one-character code Adabas stores, using the same CODE_LOOKUP table the migration lab used forwards.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>BATCH_IN</name>
        <default_value>/sync/outbox/batch-000001</default_value>
        <description>Source batch directory (CSV, written by oracle-capture)</description>
      </parameter>
      <parameter>
        <name>BATCH_OUT</name>
        <default_value>/sync/inbox/batch-000001</default_value>
        <description>Target batch directory (fixed-width, read by APPLYFIN)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/18 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/18 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>read traffic_fine.csv</name>
    <filename>${BATCH_IN}/traffic_fine.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>op</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>tx_seq</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>fine_no</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>source_isn</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>plate_no</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>offence_date</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>location</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>amount</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>status_code</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>status</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>offender_national_id</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>112</yloc></GUI>
    <description>amount arrives as TEXT with an explicit decimal point ("85.00"), never as a Hop Number: a numeric round-trip would render it through the server locale, and a comma decimal separator reaching Natural VAL() would silently become a different amount.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>add lookup domain</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>FINE_STATUS</nullif>
        <name>lookup_domain</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>288</xloc><yloc>112</yloc></GUI>
    <description>CODE_LOOKUP has a composite (domain, code) key, so the domain must be a stream field.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>reverse fine status</name>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_size>500</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>POCAPP</schema>
      <table>CODE_LOOKUP</table>
      <key>
        <name>lookup_domain</name>
        <name2/>
        <condition>=</condition>
        <field>DOMAIN</field>
      </key>
      <key>
        <name>status</name>
        <name2/>
        <condition>=</condition>
        <field>DESCRIPTION</field>
      </key>
      <value>
        <name>CODE</name>
        <rename>status_adabas</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>480</xloc><yloc>112</yloc></GUI>
    <description>Description -&gt; code, the exact reverse of the migration lab. Oracle also carries status_code, so this lookup is not the only way to get the code - it is here because resolving it independently is what a real synchroniser does, and because a description with no code is a fault worth seeing rather than guessing around. Default is blank, not a guessed code: a delete row carries no status, and inventing one would write a wrong value into Adabas.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>write traffic_fine.dat</name>
    <schema_definition/>
    <separator/>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>N</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${BATCH_OUT}/traffic_fine</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>dat</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>Y</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>op</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>1</length><precision>-1</precision></field>
      <field><name>fine_no</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>10</length><precision>-1</precision></field>
      <field><name>plate_no</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>15</length><precision>-1</precision></field>
      <field><name>offence_date</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>location</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>30</length><precision>-1</precision></field>
      <field><name>amount</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>status_adabas</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>1</length><precision>-1</precision></field>
      <field><name>offender_national_id</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>688</xloc><yloc>112</yloc></GUI>
    <description>Fixed-width, 81 bytes: empty separator/enclosure + pad=Y. Field lengths ARE the contract (CHANGE_FILE_CONTRACT.md) - Hop truncates anything longer, which is what keeps a long Oracle value from shifting every following field. The resolved description (status) is deliberately NOT written: Adabas stores only the code.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>read traffic_fine.csv</from><to>add lookup domain</to><enabled>Y</enabled></hop>
    <hop><from>add lookup domain</from><to>reverse fine status</to><enabled>Y</enabled></hop>
    <hop><from>reverse fine status</from><to>write traffic_fine.dat</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
