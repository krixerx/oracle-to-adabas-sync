<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>80_sync_vehicle</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reverse mapping: outbox vehicle.csv -&gt; fixed-width inbox vehicle.dat. Turns the standard vehicle-type code back into the legacy code Adabas stores - preferring the lineage column, because the forward mapping is many-to-one and cannot be inverted.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>BATCH_IN</name>
        <default_value>/sync/outbox/batch-000001</default_value>
        <description>Source batch directory (CSV, written by oracle-capture)</description>
      </parameter>
      <parameter>
        <name>BATCH_OUT</name>
        <default_value>/sync/inbox/batch-000001</default_value>
        <description>Target batch directory (fixed-width, read by APPLYVEH)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/18 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/18 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>read vehicle.csv</name>
    <filename>${BATCH_IN}/vehicle.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>op</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>tx_seq</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>vin</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>source_isn</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>owner_national_id</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>make</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>model</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>color</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>year_built</name><length>-1</length><type>Integer</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>source_vehicle_type</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>vehicle_type_code</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>source_fuel_desc</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>112</yloc></GUI>
    <description/>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>reverse vehicle type</name>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_size>500</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>POCAPP</schema>
      <table>VEHICLE_TYPE_MAP</table>
      <key>
        <name>vehicle_type_code</name>
        <name2/>
        <condition>=</condition>
        <field>TYPE_CODE</field>
      </key>
      <value>
        <name>SOURCE_TYPE</name>
        <rename>type_from_map</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>320</xloc><yloc>112</yloc></GUI>
    <description>⚠️ THE FORWARD MAPPING IS MANY-TO-ONE AND CANNOT BE INVERTED: SEDAN, ESTATE and HATCH all map to PC, so PC does not identify the code it came from. fail_on_multiple=N and the map returns an arbitrary member of the class. That is why this value is only a FALLBACK - see the next transform.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <name>prefer the lineage value</name>
    <type>ScriptValueMod</type>
    <description>Which legacy type code to write back, and why it is not simply the reverse lookup.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>prefer_lineage</jsScript_name>
        <jsScript_script>
// THE FORWARD MAPPING IS MANY-TO-ONE AND CANNOT BE INVERTED: SEDAN, ESTATE and
// HATCH all map to PC, so PC does not identify the code it came from. The
// migration kept the original in source_vehicle_type precisely so the round
// trip does not have to guess - that column is authoritative and exact.
//
// The reverse map is consulted ONLY when there is no lineage value, i.e. a
// vehicle created in Oracle that never had a legacy code. Letting the map win
// over a known original would silently rewrite SEDAN as ESTATE - a change
// nobody made, on the mainframe, invisible in both systems.
var lineage = source_vehicle_type == null ? "" : String(source_vehicle_type).trim();
var mapped  = type_from_map == null ? "" : String(type_from_map).trim();
var veh_type_adabas = lineage.length > 0 ? lineage : mapped;
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>veh_type_adabas</name>
        <rename>veh_type_adabas</rename>
        <type>String</type>
        <length>8</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>544</xloc>
      <yloc>112</yloc>
    </GUI>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>write vehicle.dat</name>
    <schema_definition/>
    <separator/>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>N</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${BATCH_OUT}/vehicle</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>dat</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>Y</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>op</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>1</length><precision>-1</precision></field>
      <field><name>vin</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>17</length><precision>-1</precision></field>
      <field><name>owner_national_id</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>make</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>20</length><precision>-1</precision></field>
      <field><name>model</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>20</length><precision>-1</precision></field>
      <field><name>color</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>10</length><precision>-1</precision></field>
      <field><name>year_built</name><type>Integer</type><format>0000</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>4</length><precision>0</precision></field>
      <field><name>veh_type_adabas</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>source_fuel_desc</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>20</length><precision>-1</precision></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>768</xloc><yloc>112</yloc></GUI>
    <description>Fixed-width, 108 bytes. The BASE vin is written (17), never the stored 25-character value: the suffix is a legacy encoding of "another plate for this car" and belongs to the Adabas record, not to the Oracle vehicle. APPLYVEH therefore never overwrites VIN.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>read vehicle.csv</from><to>reverse vehicle type</to><enabled>Y</enabled></hop>
    <hop><from>reverse vehicle type</from><to>prefer the lineage value</to><enabled>Y</enabled></hop>
    <hop><from>prefer the lineage value</from><to>write vehicle.dat</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
