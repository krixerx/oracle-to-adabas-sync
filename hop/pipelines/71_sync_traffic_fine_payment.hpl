<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>71_sync_traffic_fine_payment</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reverse mapping for the PE: outbox traffic_fine_payment.csv -&gt; fixed-width inbox traffic_fine_payment.dat. Turns the payment-method description back into the A2 code Adabas stores.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
      <parameter>
        <name>BATCH_IN</name>
        <default_value>/sync/outbox/batch-000001</default_value>
        <description>Source batch directory (CSV, written by oracle-capture)</description>
      </parameter>
      <parameter>
        <name>BATCH_OUT</name>
        <default_value>/sync/inbox/batch-000001</default_value>
        <description>Target batch directory (fixed-width, read by APPLYFIN)</description>
      </parameter>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/08/18 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/08/18 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>read traffic_fine_payment.csv</name>
    <filename>${BATCH_IN}/traffic_fine_payment.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field><name>parent_key</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>occurrence_index</name><length>-1</length><type>Integer</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>paid_date</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>paid_amount</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>method_code</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
      <field><name>method</name><length>-1</length><type>String</type><format/><trim_type>both</trim_type><precision>-1</precision><currency/><decimal/><group/></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>112</yloc></GUI>
    <description>paid_amount stays TEXT with an explicit decimal point, for the same locale reason as the fine amount.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>add lookup domain</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>PAY_METHOD</nullif>
        <name>lookup_domain</name>
        <type>String</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>288</xloc><yloc>112</yloc></GUI>
    <description/>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>reverse payment method</name>
    <connection>ORACLE_POC</connection>
    <cache>Y</cache>
    <cache_size>500</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>POCAPP</schema>
      <table>CODE_LOOKUP</table>
      <key>
        <name>lookup_domain</name>
        <name2/>
        <condition>=</condition>
        <field>DOMAIN</field>
      </key>
      <key>
        <name>method</name>
        <name2/>
        <condition>=</condition>
        <field>DESCRIPTION</field>
      </key>
      <value>
        <name>CODE</name>
        <rename>method_adabas</rename>
        <default/>
        <type>String</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>480</xloc><yloc>112</yloc></GUI>
    <description/>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>write traffic_fine_payment.dat</name>
    <schema_definition/>
    <separator/>
    <enclosure/>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>Y</enclosure_fix_disabled>
    <header>N</header>
    <footer>N</footer>
    <format>UNIX</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <create_parent_folder>Y</create_parent_folder>
    <file>
      <name>${BATCH_OUT}/traffic_fine_payment</name>
      <servlet_output>N</servlet_output>
      <do_not_open_new_file_init>N</do_not_open_new_file_init>
      <extention>dat</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>N</add_to_result_filenames>
      <pad>Y</pad>
      <fast_dump>N</fast_dump>
      <splitevery/>
    </file>
    <fields>
      <field><name>parent_key</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>10</length><precision>-1</precision></field>
      <field><name>occurrence_index</name><type>Integer</type><format>000</format><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>3</length><precision>0</precision></field>
      <field><name>paid_date</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>paid_amount</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>8</length><precision>-1</precision></field>
      <field><name>method_adabas</name><type>String</type><format/><currency/><decimal/><group/><nullif/><trim_type>none</trim_type><length>2</length><precision>-1</precision></field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>688</xloc><yloc>112</yloc></GUI>
    <description>Fixed-width, 31 bytes.</description>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <order>
    <hop><from>read traffic_fine_payment.csv</from><to>add lookup domain</to><enabled>Y</enabled></hop>
    <hop><from>add lookup domain</from><to>reverse payment method</to><enabled>Y</enabled></hop>
    <hop><from>reverse payment method</from><to>write traffic_fine_payment.dat</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
